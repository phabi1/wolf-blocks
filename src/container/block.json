{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wolf-blocks/container",
	"version": "0.1.0",
	"title": "Container",
	"category": "widgets",
	"icon": "smiley",
	"description": "Example block scaffolded with Create Block tool.",
	"example": {},
	"supports": {
		"html": false,
		"color": {
			"background": true,
			"text": true
		}
	},
	"attributes": {
		"topStyle": {
			"type": "string",
			"default": "none"
		},
		"topFloating": {
			"type": "boolean",
			"default": false
		},
		"bottomStyle": {
			"type": "string",
			"default": "none"
		},
		"bottomFloating": {
			"type": "boolean",
			"default": false
		}
	},
	"textdomain": "wolf-blocks",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js"
}